PORT=3001

# MongoDB Connection String:
# 1) Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/clubsphere
#
# 2) MongoDB Atlas (Cloud - Recommended):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/clubsphere?retryWrites=true&w=majority
#
MONGODB_URI=mongodb://127.0.0.1:27017/clubsphere
